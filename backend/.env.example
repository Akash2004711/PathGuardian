# PathGuardian Backend Configuration

PROJECT_NAME=PathGuardian
API_V1_STR=/api/v1
SECRET_KEY=pathguardian_super_secret_jwt_key_change_in_production_32bytes_min!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for local dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./pathguardian.db
# DATABASE_URL=postgresql://pathguardian:pathguardian_secret@localhost:5432/pathguardian

# CORS Config
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Media & Storage Paths
UPLOAD_DIR=./uploads
YOLO_MODEL_PATH=../ml/weights/yolov8n-pothole.pt
YOLO_CONFIDENCE_THRESHOLD=0.25

# SMTP / Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@pathguardian.org
EMAILS_FROM_NAME=PathGuardian Alerts

# Optional Google Maps API Key
GOOGLE_MAPS_API_KEY=
